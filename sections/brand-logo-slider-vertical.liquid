<style>
  .parent {
    display: flex;
    overflow: hidden;
    width: 200px; /* Set the width of the slider */
    align-items: center;
    justify-content: center; /* Center the images horizontally */
    background-color: var(--parent-background-color, transparent);
    height: var(--parent-height, 100px);
  }

  .scrolling-div {
    display: flex;
    flex-direction: column; /* Ensure vertical stacking of images */
    align-items: center;
    background-color: transparent;
    animation: var(--scroll-animation);
  }

  .parent.pause-on-hover:hover .scrolling-div {
    animation-play-state: paused;
  }

  .scrolling-div img {
    margin: var(--image-gap) 0;
    height: var(--image-height, 100px);
    width: auto; /* Maintain aspect ratio */
  }

  @keyframes scroll {
    from {
      transform: translateY(0); /* Start from the top */
    }
    to {
      transform: translateY(-100%); /* Move upwards */
    }
  }

  @keyframes scroll-reverse {
    from {
      transform: translateY(-100%); /* Start from the bottom */
    }
    to {
      transform: translateY(0); /* Move downwards */
    }
  }
</style>

<div class="parent parent-{{ section.id }}">
  <div class="scrolling-div scrolling-div-{{ section.id }}"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionId = "{{ section.id }}";
    const parentDivs = document.querySelectorAll(`.parent-${sectionId}`);
    const imageSets = [
      [
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/3_a35dff70-c4f6-454b-abf8-0888b2308693.png?v=1725345107",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1.png?v=1725345108",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_e5baada1-88bc-481a-8aa2-591e1d93a762.png?v=1725345108",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/3_a35dff70-c4f6-454b-abf8-0888b2308693.png?v=1725345107",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1.png?v=1725345108"
      ],
      [
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111"
      ],
      [
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/3_a35dff70-c4f6-454b-abf8-0888b2308693.png?v=1725345107",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1.png?v=1725345108",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_e5baada1-88bc-481a-8aa2-591e1d93a762.png?v=1725345108",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/3_a35dff70-c4f6-454b-abf8-0888b2308693.png?v=1725345107",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1.png?v=1725345108"
      ],
      [
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111"
      ],
      [
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/2_89d7f6a5-ee5d-475e-a67a-c6d7ded2f6b4.png?v=1725345111",
        "https://cdn.shopify.com/s/files/1/0684/3639/4200/files/1_719381d3-e8c1-479f-b36f-db5a287e16ab.png?v=1725345111"
      ]
    ];

    function addImages(imagesArray, scrollingDiv) {
      imagesArray.forEach(imageUrl => {
        const imgElement = document.createElement('img');
        imgElement.src = imageUrl;
        scrollingDiv.appendChild(imgElement);
      });
    }

    parentDivs.forEach((parentDiv, index) => {
      const scrollingDiv = parentDiv.querySelector('.scrolling-div');
      const imagesArray = imageSets[index];
      
      // Set section-specific CSS variables
      const speed = {{ section.settings.speed }};
      const isReverse = {{ section.settings.reverse }};
      const animationName = isReverse ? 'scroll-reverse' : 'scroll';
      const animation = `${animationName} ${speed}s linear infinite`;
      parentDiv.style.setProperty('--scroll-animation', animation);

      // Set image gap
      const imageGap = '{{ section.settings.gap }}';
      parentDiv.style.setProperty('--image-gap', `${imageGap}px`);

      // Set slider image height
      const imageHeight = '{{ section.settings.image_height }}';
      parentDiv.style.setProperty('--image-height', `${imageHeight}px`);

      // Set parent background color and height
      const backgroundColor = '{{ section.settings.background }}';
      const parentHeight = '{{ section.settings.parent_height }}';
      parentDiv.style.setProperty('--parent-background-color', backgroundColor);
      parentDiv.style.setProperty('--parent-height', `${parentHeight}px`);

      // Add pause-on-hover class if the setting is enabled
      const pauseOnHover = {{ section.settings.pause_on_hover }};
      if (pauseOnHover) {
        parentDiv.classList.add('pause-on-hover');
      }

      addImages(imagesArray, scrollingDiv);
    });
  });
</script>



{% schema %}
{
  "name": "Vertical Logo Slider",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Slider Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "parent_height",
      "label": "Slider Background Height (50 - 1000)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Slider Image Height (50 - 1000)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Images (0 - 100)",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slider Speed (0 - 50)",
      "min": 0,
      "max": 50,
      "unit": "s",
      "step": 5,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Slider on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Run Animation in Reverse",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical Logo Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
