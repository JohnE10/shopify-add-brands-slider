<style>
  .parent {
    display: flex;
    overflow: hidden;
    width: 100%;
    background-color: var(--parent-background-color, transparent);
    height: var(--parent-height, 500px); /* Set the predetermined height */
    align-items: flex-start; /* Align items at the top for vertical scrolling */
  }

  .scrolling-div {
    width: auto;
    height: auto;
    background-color: transparent;
    display: flex;
    flex-direction: column; /* Change to vertical stacking */
    animation: var(--scroll-animation);
  }

  .parent.pause-on-hover:hover .scrolling-div {
    animation-play-state: paused;
  }

  .scrolling-div img {
    margin: var(--image-gap) 0; /* Adjust margin for vertical layout */
    height: var(--image-height, 150px); /* Set a default image height */
    width: auto;
  }

  @keyframes scroll {
    from {
      transform: translateY(0); /* Start from the top */
    }
    to {
      transform: translateY(-100%); /* Move upwards */
    }
  }

  @keyframes scroll-reverse {
    from {
      transform: translateY(-100%); /* Start from the bottom */
    }
    to {
      transform: translateY(0); /* Move downwards */
    }
  }
</style>

<div class="parent parent-{{ section.id }}">
  <div class="scrolling-div scrolling-div-{{ section.id }}"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionId = "{{ section.id }}";
    const parentDiv = document.querySelector(`.parent-${sectionId}`);
    const scrollingDiv = document.querySelector(`.scrolling-div-${sectionId}`);

    // Initialize the images array for this section
    const imagesArray = [];

    {% for block in section.blocks %}
      imagesArray.push("{{ block.settings.image | image_url: height: block.settings.image.height }}");
    {% endfor %}

    // Set section-specific CSS variables
    const speed = {{ section.settings.speed }};
    const isReverse = {{ section.settings.reverse }};
    const animationName = isReverse ? 'scroll-reverse' : 'scroll';
    const animation = `${animationName} ${speed}s linear infinite`;
    parentDiv.style.setProperty('--scroll-animation', animation);

    // Set image gap
    const imageGap = '{{ section.settings.gap }}';
    parentDiv.style.setProperty('--image-gap', `${imageGap}px`);

    // Set slider image height
    const imageHeight = '{{ section.settings.image_height }}';
    parentDiv.style.setProperty('--image-height', `${imageHeight}px`);

    // Set parent background color and height
    const backgroundColor = '{{ section.settings.background }}';
    const parentHeight = '{{ section.settings.parent_height }}';
    parentDiv.style.setProperty('--parent-background-color', backgroundColor);
    parentDiv.style.setProperty('--parent-height', `${parentHeight}px`);

    // Add pause-on-hover class if the setting is enabled
    const pauseOnHover = {{ section.settings.pause_on_hover }};
    if (pauseOnHover) {
      parentDiv.classList.add('pause-on-hover');
    }

    const imageHeightValue = parseInt(imageHeight, 10);
    const numberOfImages = imagesArray.length;
    const screenHeight = window.innerHeight;
    const totalHeight = (imageHeightValue + 2 * parseInt(imageGap)) * numberOfImages;
    const actualNumberOfDivsNeeded = Math.floor(screenHeight / totalHeight) + 1;

    function addImages() {
      for (let i = 0; i < actualNumberOfDivsNeeded; i++) {
        imagesArray.forEach((imageUrl, index) => {
          const imgElement = document.createElement('img');
          imgElement.src = imageUrl;
          imgElement.alt = `Image ${index + 1}`;
          scrollingDiv.appendChild(imgElement);
        });
      }
      // Duplicate scrolling div
      const clone = scrollingDiv.cloneNode(true);
      parentDiv.appendChild(clone);
    }

    // Initial call to add images
    addImages();
  });
</script>

{% schema %}
{
  "name": "Vertical Logo Slider",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Slider Background Color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "parent_height",
      "label": "Slider Background Height (50 - 1000)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Slider Image Height (50 - 1000)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Images (0 - 100)",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slider Speed (0 - 50)",
      "min": 0,
      "max": 50,
      "unit": "s",
      "step": 5,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Slider on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Run Animation in Reverse",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical Logo Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
