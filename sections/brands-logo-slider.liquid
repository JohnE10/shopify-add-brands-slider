<style>
  .parent {
    display: flex;
    background-color: transparent;
    overflow: hidden;
    width: 100%;
  }

  .scrolling-div {
    width: fit-content;
    height: fit-content;
    background-color: transparent;
    animation: scroll 40s linear infinite;
    display: flex;
  }

  .scrolling-div img {
    margin: 0 20px;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

</style>

<div class="parent">
  <div class="scrolling-div"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const parentDiv = document.querySelector('.parent');
    const scrollingDiv = document.querySelector('.scrolling-div');

    // Initialize the images array for this section
    const imagesArray = [];
    const imagesWidths = [];
    let tempHight = '';

    {% for block in section.blocks %}
      imagesArray.push("{{ block.settings.image | image_url: height: 100 }}");
      console.log({{ block.settings.image.aspect_ratio }});
      tempHeight = 100;
      imagesWidths.push(tempHeight *  {{ block.settings.image.aspect_ratio }});
    {% endfor %}

    console.log('image aspect ration:', "{{ section.blocks[0].settings.image.aspect_ratio }}");
    console.log('image widths:', imagesWidths);

    console.log('imagesArray count:', imagesArray.length);

    // Set image gap
    const imageGap = 20;

    // Set slider image height
    const imageHeight = 100;

    const imageWidth = imagesWidths.reduce((sum, current) => sum + current, 0) / imagesWidths.length;
    console.log({imageWidth});
    console.log({imageGap});
    const numberOfImages = imagesArray.length;
    const screenWidth = window.innerWidth;
    console.log({screenWidth});
    // const totalWidth = (imageWidth + 2 * parseInt(imageGap)) * numberOfImages;
    const totalWidth = (imageWidth + parseInt(imageGap)) * numberOfImages;
    console.log({totalWidth});
    const actualNumberOfDivsNeeded = Math.floor(screenWidth / totalWidth);
    let numberOfImagesNeeded = Math.floor(screenWidth / (imageWidth + parseInt(imageGap))) + 1;
    if(numberOfImagesNeeded % 2 != 0) {
      numberOfImagesNeeded++;
    }
    console.log({numberOfImagesNeeded});

    const addImages = () => {
    
      for (let i = 0; i < numberOfImagesNeeded; i++) {
        const imgIndex = i % imagesArray.length; // Wrap around using modulo
        const imageUrl = imagesArray[imgIndex]; // Get the image URL
        const imgElement = document.createElement('img');
        imgElement.src = imageUrl;
        imgElement.alt = `Image ${imgIndex + 1}`; // Use imgIndex for the alt text
        scrollingDiv.appendChild(imgElement);
      }

      const clone = scrollingDiv.cloneNode(true);
      parentDiv.appendChild(clone);

    }

    // Initial call to add images
     addImages();

    console.log('image count:', document.querySelectorAll('.scrolling-div-{{ section.id }} img').length);


  });
</script>

{% schema %}
{
  "name": "Brand Logo Slider",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        }, {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logo Slider",
      "category": "Custom"
    }
  ],
  "limit": 1
}
{% endschema %}
